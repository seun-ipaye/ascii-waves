{
  "name": "ascii-waves",
  "version": "0.1.0",
  "description": "Animated ASCII waves for your website background. Works with React or plain JavaScript.",
  "keywords": [
    "ascii",
    "background",
    "canvas",
    "animation",
    "react",
    "waves",
    "ocean",
    "portfolio"
  ],
  "license": "MIT",
  "author": "Seun Samuel-Ipaye",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seun-ipaye/ascii-waves.git"
  },
  "homepage": "https://github.com/seun-ipaye/ascii-waves#readme",
  "bugs": {
    "url": "https://github.com/seun-ipaye/ascii-waves/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "peerDependencies": {
    "react": ">=17"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.1.10",
    "react": "^19.1.1",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2"
  }
}
